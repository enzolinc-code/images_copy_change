{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "liebian/parent_design.schema.json",
  "title": "ParentDesign",
  "type": "object",
  "required": ["parent_id", "design_name", "source_image", "artwork_wh", "data_trust", "upstream"],
  "additionalProperties": true,
  "properties": {
    "parent_id": { "type": "string", "pattern": "^P_[0-9]{8}_[0-9]{4}$" },
    "design_name": { "type": "string", "minLength": 2, "description": "与图案库文件名、素材目录名同名（join key）" },
    "source_image": { "type": "string", "description": "母款图案绝对路径" },
    "source_hash": { "type": "string" },
    "artwork_wh": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 },
    "template": { "type": ["string", "null"] },
    "fill_mask": { "type": ["string", "null"] },
    "fill_ratio": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "data_trust": { "enum": ["trusted", "suspect", "unknown"] },
    "theme_word": { "type": "string" },
    "upstream": {
      "type": "object",
      "required": ["item_id"],
      "additionalProperties": true,
      "properties": {
        "item_id": { "type": "string" },
        "url": { "type": "string" },
        "shop_id": { "type": "string" },
        "window_days": { "type": "integer" },
        "pay_byr": { "type": "number" },
        "pay_amt": { "type": "number" },
        "uv": { "type": "number" },
        "cart_cnt": { "type": "number" },
        "quality": { "type": "string" }
      }
    },
    "created_at": { "type": "string" }
  }
}
